# ── LLM Provider（服务端，不暴露前端）──────────────────────────
LLM_PROVIDER=deepseek                  # deepseek | qwen | doubao | openai | anthropic
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com  # OpenAI 兼容端点
LLM_MODEL_FAST=deepseek-chat           # 抽取/推断/怀疑/调和
LLM_MODEL_REASONING=deepseek-reasoner  # 对质审议（思考态可视化）

# 演示限额（防 key 被刷）
DEMO_DAILY_LIMIT=200

# ── Embedding Provider（前端可见，NEXT_PUBLIC_ 前缀）────────────
NEXT_PUBLIC_EMBEDDING_PROVIDER=local   # local（浏览器本地零 key）| cloud（云端）
NEXT_PUBLIC_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# 仅 cloud 模式需要（走 /api/embed，key 在服务端）：
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_CLOUD_MODEL=text-embedding-3-small
